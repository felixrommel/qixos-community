#!/usr/bin/env bash
# Ship this working tree to the test admin and put it to work there, in one command.
#
#   to-test-admin push     send the tree and stop there
#   to-test-admin demo     apply the split password demo, ready to try
#   to-test-admin test     run the test suite
#
# `push` is for driving the admin by hand afterwards: run one scenario, run a single
# test, or poke at a nube, without this script deciding what happens next.
#
# No commit is involved. The tree goes over the qrexec ssh tunnel as it stands, so there
# is no WIP commit to remember to throw away.
#
# What gets sent is `git ls-files -co --exclude-standard`: tracked files plus untracked
# ones git would not ignore. That set is not an implementation detail, it is the point.
# The nube reads the shipped tree as a git flake, so a file git does not know about does
# not exist as far as the build is concerned, and the far side is staged after transfer
# for the same reason. Staging is not committing; it is what makes a new file visible.
#
# Known gap: files are copied, never removed. Delete or rename something and its old name
# lingers on the admin, where the build can still see it. Until this learns to prune,
# check `git status` there after a rename.
set -uo pipefail

ADMIN=qixos-admin-test.qube
REMOTE=qixos-community

usage() {
  echo "usage: $(basename "$0") [push|demo|test] [--force]" >&2
  exit 2
}

target=${1:-}
force=${2:-}

case "$target" in
  push|demo|test) ;;
  *) usage ;;
esac

# One of these at a time, because nothing about the far side is per-run. The tree lands
# in one fixed directory, the suite's qubes have one set of names, every scenario halts
# every test-* qube before it starts, and the template is the memory bottleneck for all
# of it. Two concurrent runs do not contend, they destroy each other.
#
# Taken here rather than left to the caller: an agent that forgets it takes the whole
# suite down with it. Held through the run, not just the transfer, since the tree being
# read is the one the lock is protecting.
#
# Known gap: the lock is local, so it only serializes callers on this nube. A second dev
# nube driving the same admin needs it moved to the far side of the ssh.
LOCK=/tmp/qixos-admin-test.lock
if [ -z "${TO_TEST_ADMIN_LOCKED:-}" ]; then
  flock -n "$LOCK" true || echo "$ADMIN is busy, waiting for it..." >&2
  TO_TEST_ADMIN_LOCKED=1 exec flock "$LOCK" "$0" "$@"
fi

cd "$(dirname "$0")/../../.." || exit 1

ssh_admin() {
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$ADMIN" "$@"
}

if ! ssh_admin true; then
  echo "cannot reach $ADMIN over ssh" >&2
  exit 1
fi

# Anything modified on the admin is about to be overwritten by our copy. Losing an edit
# you forgot you made there is the same kind of unpleasant surprise as a stray WIP
# commit, so say so and stop rather than quietly clobbering it.
dirty=$(ssh_admin "cd $REMOTE && git status --porcelain --untracked-files=no")

if [ -n "$dirty" ] && [ "$force" != "--force" ]; then
  echo "$ADMIN has local changes that this would overwrite:" >&2
  printf '%s\n' "$dirty" | sed 's/^/  /' >&2
  echo "commit them there, or re-run with --force to overwrite" >&2
  exit 1
fi

echo "sending working tree to $ADMIN..."
if ! git ls-files -co --exclude-standard -z |
  tar --null -T - -cf - |
  ssh_admin "tar -xf - -C $REMOTE"; then
  echo "transfer failed" >&2
  exit 1
fi

# Commit what landed, so the tree is clean again and the dirty check above keeps meaning
# what it says. A push that only staged left the admin dirty, which made the next push
# refuse, which taught everyone to pass --force and retired the guard.
#
# Amended rather than appended, so there is one of these however many times this runs.
# The subject and the author both say what it is: nothing here is meant to be kept, and
# nothing reviews or pushes from the admin. Committing is a superset of the staging the
# flake needs, since a file git does not know about does not exist to the build either way.
#
# Only what `git add -A users/op` staged. Something changed outside that path stays dirty
# and trips the guard on the next run, which is the guard working rather than failing.
TRANSIENT="DO NOT KEEP: working tree pushed by to-test-admin"

if ! ssh_admin "set -e
  cd $REMOTE
  git add -A users/op
  if git diff --cached --quiet; then exit 0; fi
  GIT_AUTHOR_NAME=to-test-admin GIT_AUTHOR_EMAIL=to-test-admin@invalid
  GIT_COMMITTER_NAME=to-test-admin GIT_COMMITTER_EMAIL=to-test-admin@invalid
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
  if [ \"\$(git log -1 --format=%s 2>/dev/null)\" = '$TRANSIENT' ]; then
    git commit --amend --no-edit --quiet
  else
    git commit --quiet -m '$TRANSIENT'
  fi"; then
  echo "could not commit the transferred tree on $ADMIN" >&2
  exit 1
fi

case "$target" in
  push)
    echo "tree is on $ADMIN, nothing started"
    ;;
  demo)
    echo "applying the demo scenario..."
    ssh_admin "cd $REMOTE && qixos-rebuild --flake ./users/op/tests/outer-configs/demo#demo apply --update"
    ;;
  test)
    echo "running the suite..."
    ssh_admin "cd $REMOTE && ./users/op/tests/run"
    ;;
esac
